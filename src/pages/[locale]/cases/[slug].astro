---
import CasePage from "../../cases/[slug].astro";
import { cases, type CaseRecord } from "../../../data/site";
import type { ChineseLocale } from "../../../i18n";

export function getStaticPaths() {
  return (["zh-Hant", "zh-Hans"] as const).flatMap((locale) => cases.map((caseRecord) => ({ params: { locale: locale.toLowerCase(), slug: caseRecord.slug }, props: { locale, caseRecord } })));
}
interface Props { locale: ChineseLocale; caseRecord: CaseRecord }
const { locale, caseRecord } = Astro.props;
---
<CasePage locale={locale} caseRecord={caseRecord} />
