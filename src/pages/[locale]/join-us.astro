---
import JoinUsPage from "../join-us.astro";
import type { ChineseLocale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { locale: "zh-hant" }, props: { locale: "zh-Hant" } }, { params: { locale: "zh-hans" }, props: { locale: "zh-Hans" } }];
}
interface Props { locale: ChineseLocale }
const { locale } = Astro.props;
---
<JoinUsPage locale={locale} />
