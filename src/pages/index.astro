---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import CompanyIntroduction from "../components/sections/CompanyIntroduction.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import HighlightedCases from "../components/sections/HighlightedCases.astro";
import SelectedClients from "../components/sections/SelectedClients.astro";
import DeliverySection from "../components/sections/DeliverySection.astro";
import RepeatClients from "../components/sections/RepeatClients.astro";
import ClientFeedback from "../components/sections/ClientFeedback.astro";
import JoinUsCta from "../components/sections/JoinUsCta.astro";
import ArchitecturalMotion from "../components/ArchitecturalMotion.astro";
import { translate, type Locale } from "../i18n";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
---

<BaseLayout
  title={translate(locale, "seo.home.title", "Joint Win Construction & Engineering Company Limited")}
  description={translate(locale, "seo.home.description", "JWC delivers fit-out, renovation, E&M engineering and maintenance works across Macau, Hong Kong and Zhuhai.")}
  activeNav="main"
  bodyClass="home-page architectural-motion"
  locale={locale}
  canonicalPath="/"
>
  <HeroSection locale={locale} />
  <CompanyIntroduction locale={locale} />
  <ServicesSection locale={locale} />
  <HighlightedCases locale={locale} />
  <SelectedClients locale={locale} />
  <div class="delivery-scroll"><DeliverySection locale={locale} /></div>
  <RepeatClients locale={locale} />
  <ClientFeedback locale={locale} />
  <JoinUsCta locale={locale} />
  <ArchitecturalMotion />
</BaseLayout>
