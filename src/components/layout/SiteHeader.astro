---
import { localeRoute, localizedPath, translate, type Locale } from "../../i18n";

interface Props {
  activeNav?: "main" | "cases" | "contact";
  locale?: Locale;
  canonicalPath?: string;
}

const { activeNav, locale = "en", canonicalPath = "/" } = Astro.props;
const t = (key: Parameters<typeof translate>[1], english: string) => translate(locale, key, english);
const brandChineseName = locale === "en" ? "駿 旺 建 築 工 程 有 限 公 司" : t("siteIdentity.companyName", "駿旺建築工程有限公司").split("").join(" ");
const navItems = [
  { id: "main", label: t("navigation.main", "Main"), href: localizedPath(locale, "/") },
  { id: "cases", label: t("navigation.cases", "Cases"), href: localizedPath(locale, "/cases") },
  { id: "contact", label: t("navigation.contact", "Contact"), href: localizedPath(locale, "/contact") },
] as const;
const languageOptions = [
  { code: "en", label: "EN", aria: "English" },
  { code: "zh-Hant", label: "繁", aria: t("accessibility.traditionalChinese", "Traditional Chinese") },
  { code: "zh-Hans", label: "简", aria: t("accessibility.simplifiedChinese", "Simplified Chinese") },
] as const;
---

<span class="header-sentinel" data-header-sentinel aria-hidden="true"></span>
<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand-lockup" href={localizedPath(locale, "/")} aria-label={t("accessibility.homeLink", "Joint Win Construction and Engineering Company Limited, home")}>
      <span class="brand-lockup__mark" aria-hidden="true"><b>J</b><b>W</b></span>
      <span class="brand-lockup__type">
        <span lang={locale === "en" ? "zh-Hant" : locale}>{brandChineseName}</span>
        <small>Joint Win Construction &amp; Engineering Company Limited</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span class="menu-toggle__label" data-menu-label>{t("navigation.menu", "Menu")}</span>
      <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label={t("accessibility.primaryNavigation", "Primary navigation")} data-primary-nav data-menu-text={t("navigation.menu", "Menu")} data-close-text={t("navigation.close", "Close")}>
      <div class="primary-nav__links">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={["primary-nav__link", { "is-active": activeNav === item.id }]}
            aria-current={activeNav === item.id ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
      <div class="language-switcher" aria-label={t("accessibility.languageOptions", "Language options")}>
        {languageOptions.map((option, index) => (
          <>
            {index > 0 && <span aria-hidden="true">|</span>}
            <a class:list={{ "is-active": locale === option.code }} href={localeRoute(option.code, canonicalPath)} lang={option.code} hreflang={option.code} aria-label={option.aria} aria-current={locale === option.code ? "page" : undefined}>{option.label}</a>
          </>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const sentinel = document.querySelector<HTMLElement>("[data-header-sentinel]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-primary-nav]");
  const menuLabel = document.querySelector<HTMLElement>("[data-menu-label]");
  const pageRegions = Array.from(document.querySelectorAll<HTMLElement>("main, .site-footer"));
  const desktopNavigation = window.matchMedia("(min-width: 56.01rem)");
  const menuText = nav?.dataset.menuText ?? "Menu";
  const closeText = nav?.dataset.closeText ?? "Close";

  const setPageInert = (isInert: boolean) => {
    pageRegions.forEach((region) => {
      region.inert = isInert;
    });
  };

  const closeMenu = () => {
    if (!toggle || !nav) return;
    toggle.setAttribute("aria-expanded", "false");
    if (menuLabel) menuLabel.textContent = menuText;
    nav.classList.remove("is-open");
    document.body.classList.remove("menu-open");
    setPageInert(false);
  };

  toggle?.addEventListener("click", () => {
    if (!nav) return;
    const willOpen = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(willOpen));
    if (menuLabel) menuLabel.textContent = willOpen ? closeText : menuText;
    nav.classList.toggle("is-open", willOpen);
    document.body.classList.toggle("menu-open", willOpen);
    setPageInert(willOpen);
  });

  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  desktopNavigation.addEventListener("change", (event) => {
    if (event.matches) closeMenu();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle?.focus();
    }
  });

  if (header && sentinel) {
    const headerObserver = new IntersectionObserver(([entry]) => {
      header.classList.toggle("is-compact", !entry?.isIntersecting);
    });
    headerObserver.observe(sentinel);
  }
</script>
