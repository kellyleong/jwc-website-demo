---
import { withBasePath } from "../../utils/withBasePath";
---

<footer class="site-footer">
  <div class="footer-frame">
    <div class="footer-main">
      <section class="footer-brand-panel" aria-labelledby="footer-company-name">
        <a class="footer-brand" href={withBasePath("/")} aria-label="Joint Win Construction and Engineering Company Limited, home">
          <span class="footer-brand__mark" aria-hidden="true"><b>J</b><b>W</b></span>
          <strong id="footer-company-name">
            Joint Win Construction &amp;<br />Engineering Company Limited
          </strong>
        </a>
        <span class="footer-brand__rule" aria-hidden="true"></span>
        <p>Construction and engineering,<br />delivered with experience.</p>
      </section>

      <div class="footer-directory">
        <div class="footer-directory__columns">
          <nav class="footer-column" aria-labelledby="footer-explore-title">
            <h2 id="footer-explore-title">Explore</h2>
            <span class="footer-column__rule" aria-hidden="true"></span>
            <ul>
              <li><a href={withBasePath("/#who-we-are")}>About Us</a></li>
              <li><a href={withBasePath("/cases")}>Cases</a></li>
              <li><a href={withBasePath("/#selected-clients")}>Clients</a></li>
              <li><a href={withBasePath("/join-us")}>Join Us</a></li>
              <li><a href={withBasePath("/contact")}>Contact</a></li>
            </ul>
          </nav>

          <nav class="footer-column" aria-labelledby="footer-services-title">
            <h2 id="footer-services-title">Services</h2>
            <span class="footer-column__rule" aria-hidden="true"></span>
            <ul>
              <li><a href={withBasePath("/#services")}>Fit-out &amp; Renovation</a></li>
              <li><a href={withBasePath("/#services")}>E&amp;M Engineering</a></li>
              <li><a href={withBasePath("/#services")}>Maintenance</a></li>
            </ul>
          </nav>

          <section class="footer-column footer-contact" aria-labelledby="footer-contact-title">
            <h2 id="footer-contact-title">Contact</h2>
            <span class="footer-column__rule" aria-hidden="true"></span>
            <address>
              <a href="tel:+85328822992">
                <i class="ph ph-phone" aria-hidden="true"></i>
                <span>+853 2882 2992</span>
              </a>
              <a href="mailto:info@jointwin-group.com">
                <i class="ph ph-envelope-simple" aria-hidden="true"></i>
                <span>info@jointwin-group.com</span>
              </a>
              <p>
                <i class="ph ph-map-pin" aria-hidden="true"></i>
                <span>Macau</span>
              </p>
            </address>
          </section>
        </div>

        <div
          class="footer-languages"
          aria-label="Language availability: English is current. Traditional Chinese and Simplified Chinese translations are not yet available."
        >
          <span class="is-current" aria-hidden="true">EN</span>
          <i aria-hidden="true"></i>
          <span lang="zh-Hant" aria-hidden="true">繁</span>
          <i aria-hidden="true"></i>
          <span lang="zh-Hans" aria-hidden="true">简</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Joint Win Construction &amp; Engineering Company Limited. All rights reserved.</p>
      <a href="#top">Back to top <i class="ph ph-arrow-up" aria-hidden="true"></i></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-line: rgb(255 255 255 / 22%);
    --footer-muted: rgb(255 255 255 / 82%);
    display: block;
    min-height: 0;
    padding-top: clamp(2.5rem, 4vw, 4rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 81% 38%, rgb(17 67 116 / 26%), transparent 34rem),
      linear-gradient(132deg, #03152d 0%, #041d3b 48%, #03162f 100%);
    color: var(--color-on-dark);
  }

  .footer-frame {
    border-top: 1px solid var(--footer-line);
  }

  .footer-main {
    width: min(100%, var(--max-width));
    min-height: 0;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(31rem, 42%) minmax(0, 58%);
  }

  .footer-brand-panel {
    position: relative;
    isolation: isolate;
    min-width: 0;
    padding: clamp(3.75rem, 5vw, 5rem) clamp(4.5rem, 6vw, 6.5rem) 4rem var(--page-gutter);
    overflow: hidden;
    border-right: 1px solid var(--footer-line);
    background-image:
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(rgb(255 255 255 / 2%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 2%) 1px, transparent 1px);
    background-position: center;
    background-size: 4rem 4rem, 4rem 4rem, 1rem 1rem, 1rem 1rem;
  }

  .footer-brand-panel::before {
    content: "";
    position: absolute;
    z-index: -1;
    right: 17%;
    bottom: -14rem;
    width: 31rem;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    background:
      linear-gradient(135deg, transparent 49.8%, rgb(255 255 255 / 16%) 50%, transparent 50.2%),
      linear-gradient(90deg, transparent 49.8%, rgb(255 255 255 / 12%) 50%, transparent 50.2%);
  }

  .footer-brand-panel::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: -11%;
    right: clamp(2.5rem, 6vw, 6.5rem);
    width: 0.125rem;
    height: 123%;
    transform: rotate(22deg);
    transform-origin: center;
    background: var(--color-red);
  }

  .footer-brand {
    width: fit-content;
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.2vw, 2rem);
  }

  .footer-brand__mark {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: flex-end;
    color: var(--color-red);
    font-family: var(--font-display);
    font-size: clamp(3.75rem, 5vw, 5rem);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.18em;
    line-height: 0.72;
    transform: skewX(-7deg);
  }

  .footer-brand__mark b {
    font: inherit;
  }

  .footer-brand strong {
    color: white;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.65vw, 1.7rem);
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .footer-brand__rule,
  .footer-column__rule {
    display: block;
    height: 0.125rem;
    background: var(--color-red);
  }

  .footer-brand__rule {
    width: 6.25rem;
    margin: 2.5rem 0 2.25rem clamp(5.5rem, 7vw, 7rem);
  }

  .footer-brand-panel > p {
    margin: 0 0 0 clamp(5.5rem, 7vw, 7rem);
    color: var(--footer-muted);
    font-size: clamp(1.05rem, 1.35vw, 1.35rem);
    line-height: 1.38;
  }

  .footer-directory {
    min-width: 0;
    padding: clamp(3.75rem, 5vw, 5rem) var(--page-gutter) 2.5rem clamp(2.75rem, 4vw, 4.5rem);
    display: flex;
    flex-direction: column;
  }

  .footer-directory__columns {
    display: grid;
    grid-template-columns: 0.82fr 1.08fr 1.45fr;
  }

  .footer-column {
    min-width: 0;
    padding-inline: clamp(1.75rem, 3.2vw, 3.5rem);
    border-left: 1px solid var(--footer-line);
  }

  .footer-column:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .footer-column:last-child {
    padding-right: 0;
  }

  .footer-column h2 {
    margin: 0;
    color: var(--color-red);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.6vw, 1.65rem);
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .footer-column__rule {
    width: 3.5rem;
    margin-block: 1.55rem 1.8rem;
  }

  .footer-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-column li + li {
    margin-top: 0.35rem;
  }

  .footer-column a,
  .footer-contact address p {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    color: white;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    font-style: normal;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    transition: color var(--duration-hover) var(--ease-build);
  }

  .footer-column a:hover {
    color: #ff675f;
  }

  .footer-contact address {
    display: grid;
    gap: 0.35rem;
  }

  .footer-contact address a,
  .footer-contact address p {
    gap: 1rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(0.98rem, 1.15vw, 1.15rem);
    font-weight: 400;
    text-transform: none;
  }

  .footer-contact address p span {
    text-transform: uppercase;
  }

  .footer-contact address i {
    flex: 0 0 1.75rem;
    color: white;
    font-size: 1.75rem;
  }

  .footer-languages {
    min-height: 2.75rem;
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    font-size: 1rem;
    font-weight: 500;
  }

  .footer-languages span {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: inline-grid;
    place-items: center;
  }

  .footer-languages .is-current {
    color: var(--color-red);
  }

  .footer-languages i {
    width: 1px;
    height: 1.4rem;
    background: rgb(255 255 255 / 42%);
  }

  .footer-bottom {
    min-height: 6.25rem;
    padding: 1.25rem var(--page-gutter);
    border-top: 1px solid var(--footer-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-bottom p {
    margin: 0;
    color: var(--footer-muted);
    font-size: clamp(0.9rem, 1.15vw, 1.1rem);
  }

  .footer-bottom a {
    min-height: 2.75rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: white;
    font-size: 1rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    transition: color var(--duration-hover) var(--ease-build);
  }

  .footer-bottom a:hover {
    color: #ff675f;
  }

  .footer-bottom a i {
    font-size: 1.15rem;
    transition: transform var(--duration-hover) var(--ease-build);
  }

  .footer-bottom a:hover i {
    transform: translateY(-0.25rem);
  }

  @media (max-width: 80rem) {
    .footer-main {
      grid-template-columns: 36% minmax(0, 64%);
    }

    .footer-brand-panel {
      padding-right: 4.5rem;
    }

    .footer-brand {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-brand__rule,
    .footer-brand-panel > p {
      margin-left: 0;
    }

    .footer-directory {
      padding-left: 2.75rem;
    }

    .footer-column {
      padding-inline: 1.65rem;
    }
  }

  @media (max-width: 56rem) {
    .footer-main {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .footer-brand-panel {
      padding: 3.75rem var(--page-gutter);
      border-right: 0;
      border-bottom: 1px solid var(--footer-line);
    }

    .footer-brand-panel::after {
      display: none;
    }

    .footer-brand {
      align-items: center;
      flex-direction: row;
    }

    .footer-brand__rule,
    .footer-brand-panel > p {
      margin-left: clamp(5.5rem, 11vw, 7rem);
    }

    .footer-directory {
      min-height: 0;
      padding: 3.75rem var(--page-gutter) 2.5rem;
    }
  }

  @media (max-width: 43rem) {
    .site-footer {
      padding-top: 1.5rem;
    }

    .footer-brand-panel {
      padding-block: 2.5rem;
    }

    .footer-brand {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-brand__rule,
    .footer-brand-panel > p {
      margin-left: 0;
    }

    .footer-directory {
      min-height: 0;
      padding-block: 2.5rem 1.5rem;
    }

    .footer-directory__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1.25rem;
    }

    .footer-column,
    .footer-column:first-child,
    .footer-column:last-child {
      padding: 0;
      border-bottom: 0;
      border-left: 0;
    }

    .footer-column:nth-child(2) {
      padding-left: 1.5rem;
      border-left: 1px solid var(--footer-line);
    }

    .footer-contact {
      grid-column: 1 / -1;
      padding-top: 1.75rem !important;
      border-top: 1px solid var(--footer-line);
    }

    .footer-column li + li {
      margin-top: 0;
    }

    .footer-languages {
      margin-top: 1.75rem;
      justify-content: flex-start;
    }

    .footer-bottom {
      min-height: 0;
      padding-block: 1.5rem;
      align-items: flex-start;
      flex-direction: column-reverse;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-column a,
    .footer-bottom a,
    .footer-bottom a i {
      transition: none;
    }

    .footer-bottom a:hover i {
      transform: none;
    }
  }
</style>
