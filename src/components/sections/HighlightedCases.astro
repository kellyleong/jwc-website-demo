---
import CaseCard from "../cases/CaseCard.astro";
import { formatMessage, getLocalizedContent, splitHeadlinePunctuation, translate, type Locale } from "../../i18n";

interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const { caseCategories, cases, casesSection } = getLocalizedContent(locale);
const featuredCases = cases.filter((caseRecord) => caseRecord.featured).slice(0, 4);
const featuredCaseCount = featuredCases.length;
const headlineLines = casesSection.headlineLines.map(splitHeadlinePunctuation);
---

<section class="case-showcase" aria-labelledby="case-showcase-title" data-highlighted-case-filter>
  <div class="section-shell" data-reveal>
    <p class="case-showcase__label"><span aria-hidden="true"></span>{casesSection.eyebrow}</p>
    <h2 id="case-showcase-title" class="display-heading case-showcase__heading">
      {headlineLines.map((line) => <span>{line.text}{line.punctuation && <b>{line.punctuation}</b>}</span>)}
    </h2>

    <div class="case-showcase__filters" role="group" aria-label={translate(locale, "accessibility.filterBySector", "Filter highlighted cases by sector")}>
      {caseCategories.map((category, index) => (
        <button
          class:list={["case-showcase__filter", { "is-active": index === 0 }]}
          type="button"
          data-highlighted-case-filter-control={category.id}
          aria-controls="case-showcase-grid"
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {category.label}
        </button>
      ))}
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" data-highlighted-filter-status>
      {formatMessage(translate(locale, "accessibility.casesShown", "{count} cases shown."), { count: featuredCaseCount })}
    </p>

    <div id="case-showcase-grid" class="case-showcase__grid">
      {cases.map((caseRecord, index) => (
        <CaseCard
          caseRecord={caseRecord}
          eager={index < 2}
          headingLevel="h3"
          hidden={!featuredCases.includes(caseRecord)}
          featured={featuredCases.includes(caseRecord)}
          locale={locale}
        />
      ))}
    </div>

    <div class="case-showcase__action">
      <a class="button" href={casesSection.action.href}>
        {casesSection.action.label}<i class="ph ph-arrow-right" aria-hidden="true"></i>
      </a>
      <p>{casesSection.supportingCopy}</p>
    </div>
  </div>
</section>

<script type="application/json" data-highlighted-filter-messages set:html={JSON.stringify({
  all: caseCategories[0].id,
  allLabel: caseCategories[0].label,
  template: translate(locale, "accessibility.filteredCasesShown", "{count} cases shown for {sector}.")
})}></script>

<script>
  document.querySelectorAll<HTMLElement>("[data-highlighted-case-filter]").forEach((showcase) => {
    const controls = Array.from(
      showcase.querySelectorAll<HTMLButtonElement>("[data-highlighted-case-filter-control]"),
    );
    const cards = Array.from(showcase.querySelectorAll<HTMLElement>("[data-case-category]"));
    const status = showcase.querySelector<HTMLElement>("[data-highlighted-filter-status]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const messagesNode = document.querySelector<HTMLScriptElement>("[data-highlighted-filter-messages]");
    const messages = messagesNode?.textContent ? JSON.parse(messagesNode.textContent) : { all: "All", allLabel: "all sectors", template: "{count} cases shown for {sector}." };

    const selectFilter = (selectedControl: HTMLButtonElement) => {
      const category = selectedControl.dataset.highlightedCaseFilterControl ?? messages.all;
      const previousPositions = new Map(
        cards.filter((card) => !card.hidden).map((card) => [card, card.getBoundingClientRect()]),
      );

      controls.forEach((control) => {
        const selected = control === selectedControl;
        control.classList.toggle("is-active", selected);
        control.setAttribute("aria-pressed", String(selected));
      });

      cards.forEach((card) => {
        card.hidden = category === messages.all
          ? card.dataset.caseFeatured !== "true"
          : card.dataset.caseCategory !== category;
      });

      const visibleCards = cards.filter((card) => !card.hidden);

      if (!reducedMotion.matches) {
        visibleCards.forEach((card) => {
          const previous = previousPositions.get(card);
          const current = card.getBoundingClientRect();

          if (previous) {
            const horizontalTravel = previous.left - current.left;
            const verticalTravel = previous.top - current.top;
            if (horizontalTravel !== 0 || verticalTravel !== 0) {
              card.animate(
                [
                  { transform: `translate(${horizontalTravel}px, ${verticalTravel}px)` },
                  { transform: "translate(0, 0)" },
                ],
                { duration: 360, easing: "cubic-bezier(.22, 1, .36, 1)" },
              );
            }
          } else {
            card.animate(
              [
                { opacity: 0, transform: "translateY(12px) scale(.99)" },
                { opacity: 1, transform: "translateY(0) scale(1)" },
              ],
              { duration: 360, easing: "cubic-bezier(.22, 1, .36, 1)" },
            );
          }
        });
      }

      if (status) {
        const label = selectedControl.textContent?.trim() || messages.allLabel;
        status.textContent = messages.template.replace("{count}", String(visibleCards.length)).replace("{sector}", label);
      }
    };

    controls.forEach((control) => {
      control.addEventListener("click", () => selectFilter(control));
    });
  });
</script>

<style>
  .case-showcase {
    min-height: 0;
    padding-block: clamp(3.5rem, 5vw, 4.5rem) clamp(2.5rem, 3.5vw, 3.5rem);
    display: flex;
    align-items: center;
    background: var(--color-ground);
  }

  .case-showcase__label {
    margin-bottom: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-red-dark);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .case-showcase__label span {
    width: 1.75rem;
    height: 0.125rem;
    background: var(--color-red);
  }

  .case-showcase__heading {
    max-width: none;
    margin-bottom: 1.5rem;
    font-size: clamp(3.1rem, 3.8vw, 4rem);
  }

  .case-showcase__heading > span {
    display: block;
    white-space: nowrap;
  }

  .case-showcase__heading b {
    color: var(--color-red);
    font: inherit;
  }

  .case-showcase__filters {
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .case-showcase__filters::-webkit-scrollbar { display: none; }

  .case-showcase__filter {
    position: relative;
    flex: 0 0 auto;
    min-height: 3rem;
    padding: 0.65rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--duration-control) var(--ease-build);
  }

  .case-showcase__filter:hover,
  .case-showcase__filter.is-active {
    color: var(--color-red-dark);
  }

  .case-showcase__filter::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 0.125rem;
    transform: scaleX(0);
    transform-origin: right;
    background: var(--color-red);
    transition: transform var(--duration-control) var(--ease-build);
  }

  .case-showcase__filter:hover::after,
  .case-showcase__filter.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .case-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  :global(.case-showcase .case-card[hidden]) {
    display: none;
  }

  .case-showcase__action {
    margin-top: 1.65rem;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
  }

  .case-showcase__action p {
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 64rem) {
    .case-showcase__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .case-showcase__filters { justify-content: flex-start; }
  }

  @media (max-width: 39rem) {
    .case-showcase { min-height: 0; padding-block: 3.5rem; }
    .case-showcase__heading { margin-bottom: 1rem; font-size: clamp(2.5rem, 10.5vw, 3.5rem); line-height: 0.94; }
    .case-showcase__heading > span { white-space: normal; }

    .case-showcase__filters {
      margin: 0 0 1.5rem;
      padding: 0;
      flex-wrap: wrap;
      overflow: visible;
      gap: 0.4rem 0.75rem;
    }
    .case-showcase__filter { min-width: 2.75rem; min-height: 2.75rem; padding-inline: 0.4rem; font-size: 0.95rem; }
    .case-showcase__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .case-showcase__action { margin-top: 1.5rem; justify-items: stretch; }
    .case-showcase__action p { max-width: 26rem; text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-showcase__filter,
    .case-showcase__filter::after {
      transition: none;
    }
  }
</style>
